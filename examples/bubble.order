program sorting

# Bubble sort.  Write it, then let Order tell you what you wrote.

function random_numbers(n):
    give random_list(n, 1, 1000)
end

function bubble_sort(numbers):
    let work be copy(numbers)
    let n be length(work)
    let i be 0
    while i < n:
        let j be 0
        while j < n - 1:
            if work[j] > work[j + 1]:
                swap(work, j, j + 1)
            end
            j becomes j + 1
        end
        i becomes i + 1
    end
    give work
end

measure bubble_sort with random_numbers at 50, 100, 200, 400
